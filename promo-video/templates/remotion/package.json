{
  "name": "promo-remotion",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Promo ../out/promo.mp4 --codec h264 --crf 18",
    "render:vertical": "remotion render PromoVertical ../out/promo-9x16.mp4 --codec h264 --crf 18",
    "render:square": "remotion render PromoSquare ../out/promo-1x1.mp4 --codec h264 --crf 18",
    "render:landscape": "remotion render PromoLandscape ../out/promo-16x9.mp4 --codec h264 --crf 18",
    "still": "remotion still Promo ../out/still.png --frame 60"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
